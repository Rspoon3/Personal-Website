---
import { Image } from "astro:assets";
import type { BlogPost } from "../lib/blog";
import PostMeta from "./PostMeta.astro";
import TagList from "./TagList.astro";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="text-gray-600 dark:text-gray-400">No posts yet. Check back soon!</p>
  ) : (
    <ul id="post-list" class="list-none p-0 m-0 space-y-12">
      {posts.map((post) => (
        <li data-post-id={post.id}>
          <article class="space-y-3">
            {post.data.cover && (
              <a href={`/blog/${post.id}`} class="block">
                <Image
                  src={post.data.cover as ImageMetadata}
                  alt={post.data.coverAlt}
                  width={640}
                  class="w-full rounded-lg"
                />
              </a>
            )}
            <PostMeta post={post} />
            <h2 class="text-2xl font-bold leading-snug">
              <a href={`/blog/${post.id}`} class="hover:text-orange-500 transition-colors">
                {post.data.title}
              </a>
            </h2>
            {post.data.description && (
              <p class="text-gray-700 dark:text-gray-300">{post.data.description}</p>
            )}
            <TagList tags={post.data.tags} />
          </article>
        </li>
      ))}
    </ul>
  )
}
