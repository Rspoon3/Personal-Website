---
import { tagSlug } from "../lib/blog";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
      {tags.map((tag) => (
        <li>
          <a
            href={`/blog/tags/${tagSlug(tag)}`}
            class="inline-block rounded-full bg-gray-100 dark:bg-neutral-800 px-3 py-1 text-xs text-gray-700 dark:text-gray-300 hover:opacity-70 transition-opacity"
          >
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
