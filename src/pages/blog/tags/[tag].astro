---
import BlogLayout from "../../../layouts/BlogLayout.astro";
import PostList from "../../../components/PostList.astro";
import { getPosts, tagSlug } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  for (const post of posts) {
    for (const tag of post.data.tags) tags.set(tagSlug(tag), tag);
  }
  return [...tags].map(([slug, label]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)),
    },
  }));
}

const { label, posts } = Astro.props;
---

<BlogLayout title={`#${label} | Blog | Richard Witherspoon`}>
  <p class="mb-2"><a href="/blog" class="text-orange-500 hover:opacity-70 transition-opacity">&larr; All posts</a></p>
  <h1 class="text-4xl font-extrabold mb-12">#{label}</h1>
  <PostList posts={posts} />
</BlogLayout>
